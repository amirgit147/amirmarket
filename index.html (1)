<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>امیر مارکت | هایپرمارکت آنلاین مواد غذایی (طرح اکالا)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --red: #e6123d; --red-dark: #cf0e35; --red-light: #fef2f3;
      --green: #02a050; --bg: #f8f9fa; --card: #ffffff;
      --text: #1f2937; --sub: #64748b; --border: #e5e7eb;
      --radius: 14px;
    }
    body.dark-mode {
      --bg: #0b0f19; --card: #151d32; --text: #f8fafc;
      --sub: #94a3b8; --border: #232f48; --red-light: rgba(230,18,61,0.18);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Vazirmatn', sans-serif; }
    body { background: var(--bg); color: var(--text); direction: rtl; text-align: right; line-height: 1.6; font-size: 14px; transition: 0.25s ease; }
    .container { max-width: 1320px; margin: 0 auto; padding: 0 16px; }
    button { cursor: pointer; border: none; background: none; font-family: inherit; }
    a { text-decoration: none; color: inherit; }
    img { max-width: 100%; display: block; }

    /* Top Bar */
    .top-bar { background: #111827; color: #fff; font-size: 12px; padding: 7px 0; }
    .top-bar-inner { display: flex; justify-content: space-between; align-items: center; }
    .pill-red { background: var(--red); color: #fff; padding: 2px 10px; border-radius: 99px; font-weight: 800; font-size: 11px; }

    /* Header */
    .header { position: sticky; top: 0; z-index: 100; background: var(--card); border-bottom: 1px solid var(--border); box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
    .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 0; }
    .logo-box { display: flex; align-items: center; gap: 10px; }
    .logo-badge { width: 48px; height: 48px; background: #000; border-radius: 12px; padding: 3px; border: 1.5px solid #ffc107; box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
    .brand-title { font-size: 21px; font-weight: 900; line-height: 1; }
    .loc-btn { display: flex; align-items: center; gap: 6px; background: var(--bg); border: 1px solid var(--border); padding: 8px 14px; border-radius: 99px; font-size: 12px; font-weight: 700; color: var(--text); }
    .search-wrap { flex: 1; max-width: 560px; position: relative; }
    .search-input { width: 100%; height: 44px; background: var(--bg); border: 1.5px solid transparent; border-radius: 99px; padding: 0 42px 0 38px; font-size: 13px; color: var(--text); outline: none; }
    .search-input:focus { background: var(--card); border-color: var(--red); box-shadow: 0 0 0 3px rgba(230,18,61,0.12); }
    .search-ico { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); font-size: 15px; color: var(--sub); }
    .search-drop { position: absolute; top: calc(100% + 6px); right: 0; left: 0; background: var(--card); border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.12); padding: 10px; z-index: 60; display: none; }
    .search-drop.open { display: block; }
    .btn-act { display: flex; align-items: center; gap: 6px; background: var(--bg); color: var(--text); padding: 8px 14px; border-radius: 99px; border: 1px solid var(--border); font-size: 12.5px; font-weight: 700; }
    .cart-btn { display: flex; align-items: center; gap: 8px; background: var(--red); color: #fff; padding: 8px 18px; border-radius: 99px; box-shadow: 0 4px 12px rgba(230,18,61,0.3); font-weight: 800; }

    /* Subheader */
    .subnav { background: var(--card); border-top: 1px solid var(--border); padding: 6px 0; }
    .subnav-list { display: flex; align-items: center; gap: 16px; list-style: none; overflow-x: auto; white-space: nowrap; }
    .subnav-link { font-size: 12.5px; font-weight: 600; color: var(--sub); padding: 6px 8px; }
    .subnav-link.fire { color: var(--red) !important; font-weight: 800; }

    /* Hero */
    .hero { padding: 20px 0 16px; }
    .hero-grid { display: grid; grid-template-columns: 1fr 310px; gap: 18px; }
    .carousel { position: relative; background: var(--card); border-radius: var(--radius); border: 1px solid var(--border); min-height: 330px; overflow: hidden; }
    .slide { position: absolute; inset: 0; display: grid; grid-template-columns: 1fr 1fr; align-items: center; padding: 32px 38px; opacity: 0; visibility: hidden; transition: 0.4s ease; }
    .slide.active { opacity: 1; visibility: visible; }
    .btn-hero { display: inline-block; background: var(--red); color: #fff; padding: 9px 20px; border-radius: 99px; font-size: 13px; font-weight: 800; margin-top: 14px; }
    .side-cards { display: flex; flex-direction: column; gap: 14px; }
    .side-card { flex: 1; border-radius: var(--radius); padding: 18px; display: flex; align-items: center; justify-content: space-between; cursor: pointer; }
    .card-pink { background: linear-gradient(135deg, #fff1f2, #ffe4e6); border: 1px solid #fecdd3; color: #9f1239; }
    .card-blue { background: linear-gradient(135deg, #eff6ff, #dbeafe); border: 1px solid #bfdbfe; color: #1e40af; }
    body.dark-mode .card-pink { background: #2d121c; border-color: #5b2137; color: #fda4af; }
    body.dark-mode .card-blue { background: #101c38; border-color: #1e3a8a; color: #93c5fd; }

    /* Stories */
    .stories { padding: 12px 0 18px; }
    .stories-row { display: flex; gap: 18px; overflow-x: auto; padding-bottom: 6px; scrollbar-width: none; }
    .story { display: flex; flex-direction: column; align-items: center; gap: 6px; cursor: pointer; flex-shrink: 0; }
    .story-ring { width: 66px; height: 66px; border-radius: 50%; background: var(--card); border: 2.5px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 26px; transition: 0.2s; }
    .story:hover .story-ring { border-color: var(--red); transform: translateY(-3px); }

    /* Incredible Deals Red Box (Okala Style) */
    .deals-sec { padding: 18px 0; }
    .deals-box { background: linear-gradient(135deg, #e6123d, #b80829); border-radius: var(--radius); padding: 20px; display: grid; grid-template-columns: 220px 1fr; gap: 16px; align-items: center; box-shadow: 0 10px 24px rgba(230,18,61,0.25); }
    .deals-side { color: #fff; text-align: center; }
    .timer-wrap { background: rgba(0,0,0,0.2); padding: 8px 12px; border-radius: 10px; margin: 10px 0; }
    .timer-box { background: #fff; color: #111; padding: 4px 6px; border-radius: 5px; font-weight: 900; min-width: 36px; display: inline-block; font-size: 14px; }
    .deals-scroll { display: flex; gap: 14px; overflow-x: auto; padding-bottom: 6px; }

    /* Catalog Layout */
    .catalog { padding: 10px 0 36px; }
    .catalog-layout { display: grid; grid-template-columns: 240px 1fr; gap: 18px; align-items: flex-start; }
    .sidebar { position: sticky; top: 80px; background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; }
    .cat-btn { text-align: right; padding: 6px 10px; border-radius: 6px; font-size: 12px; font-weight: 600; color: var(--sub); display: block; width: 100%; }
    .cat-btn.active { background: var(--red-light); color: var(--red); font-weight: 800; }
    .top-filter-bar { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 10px 16px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; }
    .sort-pill { font-size: 12px; font-weight: 600; color: var(--sub); padding: 4px 10px; border-radius: 99px; }
    .sort-pill.active { background: var(--red); color: #fff; font-weight: 800; }

    /* Product Cards */
    .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(215px, 1fr)); gap: 14px; }
    .deal-card { flex: 0 0 195px; }
    .p-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 12px; display: flex; flex-direction: column; position: relative; transition: 0.2s; }
    .p-card:hover { transform: translateY(-3px); box-shadow: 0 6px 16px rgba(0,0,0,0.08); border-color: rgba(230,18,61,0.3); }
    .badge-disc { background: var(--red); color: #fff; font-size: 11px; font-weight: 800; padding: 2px 7px; border-radius: 99px; }
    .img-box { width: 100%; height: 160px; background: #fff; border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer; margin-bottom: 8px; overflow: hidden; }
    body.dark-mode .img-box { background: #1e293b; }
    .img-box img { max-width: 90%; max-height: 90%; object-fit: contain; transition: 0.3s; }
    .p-card:hover .img-box img { transform: scale(1.08); }
    .p-title { font-size: 13px; font-weight: 700; height: 38px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 6px; cursor: pointer; }
    .p-price-row { margin-top: auto; display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 10px; }
    .old-p { font-size: 11px; color: var(--sub); text-decoration: line-through; }
    .new-p { font-size: 16px; font-weight: 900; color: var(--text); }
    .btn-add-p { width: 100%; height: 35px; background: var(--red-light); color: var(--red); border: 1.5px solid var(--red); border-radius: 8px; font-size: 12px; font-weight: 800; }
    .btn-add-p:hover { background: var(--red); color: #fff; }
    .qty-box { width: 100%; height: 35px; background: var(--red); color: #fff; border-radius: 8px; display: flex; align-items: center; justify-content: space-between; padding: 0 8px; font-weight: 900; }

    /* Drawer Cart */
    .cart-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; opacity: 0; visibility: hidden; transition: 0.25s; }
    .cart-overlay.open { opacity: 1; visibility: visible; }
    .drawer { position: fixed; top: 0; left: 0; bottom: 0; width: 100%; max-width: 400px; background: var(--card); z-index: 1001; display: flex; flex-direction: column; transform: translateX(-100%); transition: 0.3s; }
    .drawer.open { transform: translateX(0); }
    .drawer-head { display: flex; justify-content: space-between; padding: 14px 16px; border-bottom: 1px solid var(--border); font-size: 15px; font-weight: 800; }
    .drawer-list { flex: 1; overflow-y: auto; padding: 12px 16px; display: flex; flex-direction: column; gap: 10px; }
    .drawer-item { display: flex; align-items: center; gap: 10px; background: var(--bg); border: 1px solid var(--border); padding: 8px; border-radius: 8px; }
    .drawer-thumb { width: 46px; height: 46px; border-radius: 6px; object-fit: cover; }
    .drawer-foot { background: var(--card); border-top: 1px solid var(--border); padding: 14px 16px; }
    .btn-order { width: 100%; height: 44px; background: var(--red); color: #fff; border-radius: 10px; font-size: 14px; font-weight: 800; margin-top: 10px; }

    /* Modal */
    .modal-wrap { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 2000; display: flex; align-items: center; justify-content: center; padding: 16px; opacity: 0; visibility: hidden; transition: 0.2s; }
    .modal-wrap.open { opacity: 1; visibility: visible; }
    .modal { background: var(--card); border-radius: var(--radius); max-width: 520px; width: 100%; padding: 22px; position: relative; border: 1px solid var(--border); }
    .modal-x { position: absolute; top: 12px; left: 12px; width: 28px; height: 28px; border-radius: 50%; background: var(--bg); display: flex; align-items: center; justify-content: center; font-weight: bold; cursor: pointer; }

    /* Toast */
    .toast-box { position: fixed; bottom: 20px; right: 20px; z-index: 3000; display: flex; flex-direction: column; gap: 8px; }
    .toast { background: #1f2937; color: #fff; padding: 10px 16px; border-radius: 8px; font-size: 12.5px; font-weight: 600; border-right: 4px solid var(--red); }

    /* Mobile Bar */
    .mobile-bar { display: none; position: fixed; bottom: 0; left: 0; right: 0; background: var(--card); border-top: 1px solid var(--border); z-index: 900; padding: 6px 12px; justify-content: space-around; }
    .mob-item { display: flex; flex-direction: column; align-items: center; font-size: 11px; font-weight: 600; color: var(--sub); }

    /* Responsive */
    @media (max-width: 992px) {
      .hero-grid, .deals-box, .catalog-layout { grid-template-columns: 1fr; }
      .sidebar { position: static; }
    }
    @media (max-width: 768px) {
      body { padding-bottom: 55px; }
      .top-bar, .subnav, .side-cards, .hero-img-box { display: none; }
      .header-inner { flex-wrap: wrap; }
      .search-wrap { order: 3; max-width: 100%; }
      .slide { grid-template-columns: 1fr; text-align: center; }
      .mobile-bar { display: flex; }
      .drawer { max-width: 100%; }
    }
  </style>
</head>
<body class="light-mode">

