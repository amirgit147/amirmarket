  <script>
    const P = [
      {id:1, name:"شکلات صبحانه فندقی نوتلا اصل (۳۵۰ گرمی)", category:"snacks", brand:"نوتلا (Nutella)", originalPrice:345000, price:279000, discount:19, reviews:428, weight:"۳۵۰ گرم", image:"https://images.unsplash.com/photo-1541781774459-bb2af2f05b55?w=500", isSpecial:true, desc:"شکلات صبحانه فندقی اصل نوتلا تهیه شده از مرغوب‌ترین فندق‌ها و کاکائوی درجه یک."},
      {id:2, name:"بیسکویت مادر مینو ویتامینه (بسته‌بندی ۱۴۰ گرمی)", category:"snacks", brand:"مینو (Minoo)", originalPrice:28000, price:22400, discount:20, reviews:852, weight:"۱۴۰ گرم", image:"https://images.unsplash.com/photo-1558961363-fa8fdf82db35?w=500", isSpecial:true, desc:"بیسکویت نوستالژیک مادر مینو حاوی ویتامین‌های A و D، میان‌وعده‌ای سالم و پرانرژی."},
      {id:3, name:"شکلات صبحانه دو رنگ فندقی فرمند (۳۳۰ گرمی)", category:"snacks", brand:"فرمند (Farmand)", originalPrice:115000, price:89000, discount:23, reviews:215, weight:"۳۳۰ گرم", image:"https://images.unsplash.com/photo-1571506165871-ee72a35bc9d4?w=500", isSpecial:true, desc:"شکلات صبحانه کرمی و دورنگ فرمند با طعم فندق و کاکائو."},
      {id:4, name:"شیر پرچرب بطری کاله (۱ لیتر ۳٪ چربی)", category:"dairy", brand:"کاله (Kalleh)", originalPrice:42000, price:35700, discount:15, reviews:540, weight:"۱ لیتر", image:"https://images.unsplash.com/photo-1550583724-b2692b85b150?w=500", isSpecial:true, desc:"شیر تازه پاستوریزه کاله با کیفیت ممتاز و سرشار از کلسیم."},
      {id:5, name:"کره حیوانی پاستوریزه شکلی (۱۰۰ گرمی)", category:"dairy", brand:"شکلی (Shekly)", originalPrice:36000, price:30600, discount:15, reviews:198, weight:"۱۰۰ گرم", image:"https://images.unsplash.com/photo-1589985270826-4b7bb135bc9d?w=500", isSpecial:false, desc:"کره صبحانه اصیل شکلی تهیه شده از خامه پاستوریزه تازه با عطر طبیعی."},
      {id:6, name:"برنج طارم هاشمی درجه یک گیلان (۵ کیلوگرمی)", category:"grocery", brand:"طارم گیلان", originalPrice:820000, price:697000, discount:15, reviews:630, weight:"۵ کیلوگرم", image:"https://images.unsplash.com/photo-1586201375761-83865001e31c?w=500", isSpecial:true, desc:"برنج طارم هاشمی معطر و دو الکه شالیزارهای گیلان با ری‌کش عالی."},
      {id:7, name:"روغن سرخ‌کردنی شفاف بدون پالم بهار (۱.۵ لیتری)", category:"grocery", brand:"بهار (Bahar)", originalPrice:142000, price:116400, discount:18, reviews:410, weight:"۱.۵ لیتر", image:"https://images.unsplash.com/photo-1474979266404-7eaacbcd87c5?w=500", isSpecial:true, desc:"روغن مخصوص سرخ کردن بهار بدون پالم با مقاومت حرارتی بالا."},
      {id:8, name:"ماکارونی اسپاگتی زر ماکارون قطر ۱.۲ (۷۰۰ گرمی)", category:"grocery", brand:"زر ماکارون (Zar)", originalPrice:34000, price:27200, discount:20, reviews:780, weight:"۷۰۰ گرم", image:"https://images.unsplash.com/photo-1621996346565-e3d5d6281691?w=500", isSpecial:false, desc:"ماکارونی رشته‌ای زر ماکارون تولید شده از آرد سمولینای اعلا."},
      {id:9, name:"چای سیلان ارل گری معطر سوفیا (۵۰۰ گرمی)", category:"drinks", brand:"سوفیا (Sophia)", originalPrice:285000, price:228000, discount:20, reviews:340, weight:"۵۰۰ گرم", image:"https://images.unsplash.com/photo-1576092768241-dec231879fc3?w=500", isSpecial:true, desc:"چای سیاه شکسته سیلان با عصاره طبیعی برگاموت و عطر ماندگار."},
      {id:10, name:"پاستیل خرسی میوه‌ای میکس ببتو (۸۰ گرمی)", category:"snacks", brand:"ببتو (Bebeto)", originalPrice:42000, price:29400, discount:30, reviews:620, weight:"۸۰ گرم", image:"https://images.unsplash.com/photo-1582058091505-f87a2e55a40f?w=500", isSpecial:true, desc:"پاستیل‌های خرسی خوشمزه با طعم آبمیوه‌های طبیعی و ژلاتین حلال."},
      {id:11, name:"مایع دستشویی کرمی اکتیو با عصاره بادام (۴۵۰ گرم)", category:"hygiene", brand:"اکتیو (Active)", originalPrice:62000, price:46500, discount:25, reviews:580, weight:"۴۵۰ گرم", image:"https://images.unsplash.com/photo-1608248597359-59841804ff2b?w=500", isSpecial:false, desc:"فرمولاسیون لطیف حاوی کرم مرطوب‌کننده و پروتئین شیر و بادام."},
      {id:12, name:"رب گوجه فرنگی قوطی روژین (۸۰۰ گرمی)", category:"grocery", brand:"روژین (Rojin)", originalPrice:72000, price:54000, discount:25, reviews:520, weight:"۸۰۰ گرم", image:"https://images.unsplash.com/photo-1592924357228-91a4daadcfea?w=500", isSpecial:true, desc:"رب گوجه خالص و غلیظ روژین بدون مواد افزودنی و نگه‌دارنده."}
    ];

    let cart = JSON.parse(localStorage.getItem('am_cart')) || {};
    let curCat = 'all', curSort = 'popular', searchQ = '';

    const fa = n => (n === null || n === undefined) ? '' : n.toString().replace(/[0-9]/g, w => ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'][+w]);
    const pr = n => !n ? '۰' : fa(n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, "٬"));

    function card(p, isDeal = false) {
      const q = cart[p.id] || 0;
      return `
        <div class="p-card ${isDeal ? 'deal-card' : ''}">
          <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
            <span class="badge-disc">${fa(p.discount)}٪-</span>
            <span style="font-size:10.5px; color:var(--green); font-weight:700;">ارسال ۴۵دقیقه ⚡</span>
          </div>
          <div class="img-box" onclick="window.openP(${p.id})">
            <img src="${p.image}" alt="${p.name}" loading="lazy" />
          </div>
          <span style="font-size:11px; font-weight:700; color:var(--sub);">${p.brand}</span>
          <h4 class="p-title" onclick="window.openP(${p.id})">${p.name}</h4>
          <div class="p-price-row">
            <span class="old-p">${pr(p.originalPrice)} ت</span>
            <strong class="new-p">${pr(p.price)} تومان</strong>
          </div>
          <div>
            ${q === 0 ? `
              <button class="btn-add-p" onclick="window.add(${p.id})">+ افزودن به سبد</button>
            ` : `
              <div class="qty-box">
                <button onclick="window.add(${p.id})" style="color:#fff; font-size:16px;">+</button>
                <span>${fa(q)}</span>
                <button onclick="window.remove(${p.id})" style="color:#fff; font-size:16px;">${q===1?'🗑️':'−'}</button>
              </div>
            `}
          </div>
        </div>
      `;
    }

    function render() {
      const g = document.getElementById('mainGrid');
      let list = P.filter(p => (curCat === 'all' || p.category === curCat) && (!searchQ || p.name.includes(searchQ) || p.brand.includes(searchQ)));
      if (curSort === 'discount') list.sort((a,b) => b.discount - a.discount);
      else if (curSort === 'price-asc') list.sort((a,b) => a.price - b.price);
      else if (curSort === 'price-desc') list.sort((a,b) => b.price - a.price);
      else list.sort((a,b) => b.reviews - a.reviews);
      document.getElementById('cntBadge').textContent = `${fa(list.length)} کالا`;
      g.innerHTML = list.map(p => card(p)).join('');
      document.getElementById('dealsGrid').innerHTML = P.filter(p => p.isSpecial).map(p => card(p, true)).join('');
    }

    window.add = id => { cart[id] = (cart[id] || 0) + 1; save(); toast('کالا به سبد اضافه شد'); };
    window.remove = id => { if (cart[id]) { cart[id]--; if (!cart[id]) delete cart[id]; save(); } };
    function save() { localStorage.setItem('am_cart', JSON.stringify(cart)); updateCart(); }

    function updateCart() {
      let count = 0, total = 0;
      for (const [id, q] of Object.entries(cart)) {
        const p = P.find(x => x.id === +id);
        if (p) { count += q; total += p.price * q; }
      }
      document.getElementById('hCartCount').textContent = fa(count);
      document.getElementById('hCartTotal').textContent = `${pr(total)} تومان`;
      document.getElementById('cCount').textContent = fa(count);
      document.getElementById('cFinal').textContent = `${pr(total)} تومان`;
      const sTxt = document.getElementById('shipTxt');
      if (total >= 300000) sTxt.textContent = '🎉 ارسال این سفارش رایگان است!';
      else sTxt.textContent = `تنها ${pr(300000 - total)} تومان دیگر تا ارسال رایگان!`;

      const cl = document.getElementById('cartList');
      if (!count) cl.innerHTML = '<div style="text-align:center; padding:30px; color:var(--sub);">سبد خرید خالی است</div>';
      else cl.innerHTML = Object.entries(cart).map(([id, q]) => {
        const p = P.find(x => x.id === +id);
        return p ? `<div class="drawer-item"><img src="${p.image}" class="drawer-thumb" /><div><strong style="font-size:12px;">${p.name}</strong><div style="color:var(--red); font-weight:800; font-size:12px;">${pr(p.price * q)} ت</div></div><div style="margin-right:auto; display:flex; gap:8px;"><button onclick="window.add(${p.id})">+</button><span>${fa(q)}</span><button onclick="window.remove(${p.id})">${q===1?'🗑️':'−'}</button></div></div>` : '';
      }).join('');
      render();
    }

    window.filterCat = c => { curCat = c; document.querySelectorAll('.cat-btn').forEach(b => b.classList.toggle('active', b.dataset.cat === c)); render(); };
    window.resetFilters = () => { curCat = 'all'; searchQ = ''; document.getElementById('searchInput').value = ''; window.filterCat('all'); };
    window.setSort = (s, btn) => { curSort = s; document.querySelectorAll('.sort-pill').forEach(b => b.classList.remove('active')); btn.classList.add('active'); render(); };

    window.openCart = () => { document.getElementById('cartDrawer').classList.add('open'); document.getElementById('cartOverlay').classList.add('open'); };
    window.closeCart = () => { document.getElementById('cartDrawer').classList.remove('open'); document.getElementById('cartOverlay').classList.remove('open'); };

    window.openP = id => {
      const p = P.find(x => x.id === id);
      if (p) {
        document.getElementById('mBody').innerHTML = `<div style="display:flex; gap:16px; align-items:center;"><img src="${p.image}" style="width:160px; border-radius:8px;" /><div><h3 style="font-size:16px;">${p.name}</h3><p style="font-size:12.5px; color:var(--sub); margin:6px 0;">${p.desc}</p><div style="font-size:16px; font-weight:900; color:var(--red); margin-bottom:10px;">${pr(p.price)} تومان</div><button class="btn-order" onclick="window.add(${p.id}); window.closePModal();">افزودن به سبد</button></div></div>`;
        document.getElementById('pModal').classList.add('open');
      }
    };
    window.closePModal = () => document.getElementById('pModal').classList.remove('open');

    window.openAddr = () => document.getElementById('aModal').classList.add('open');
    window.closeAModal = () => document.getElementById('aModal').classList.remove('open');
    window.saveAddr = () => { document.getElementById('curAddr').textContent = document.querySelector('input[name="addr"]:checked').value; window.closeAModal(); toast('آدرس بروز شد'); };

    window.checkout = () => {
      window.closeCart();
      document.getElementById('tCode').textContent = `AMIR-${Math.floor(10000 + Math.random()*90000)}`;
      document.getElementById('doneModal').classList.add('open');
      cart = {}; save();
    };
    window.closeDone = () => document.getElementById('doneModal').classList.remove('open');

    function toast(msg) {
      const b = document.getElementById('tBox');
      const t = document.createElement('div'); t.className = 'toast'; t.textContent = msg; b.appendChild(t);
      setTimeout(() => t.remove(), 2500);
    }

    const inp = document.getElementById('searchInput'), drop = document.getElementById('searchDrop');
    inp.addEventListener('input', e => {
      searchQ = e.target.value.trim();
      drop.classList.toggle('open', !!searchQ);
      if (searchQ) {
        const m = P.filter(p => p.name.includes(searchQ)).slice(0, 3);
        document.getElementById('searchResList').innerHTML = m.map(p => `<div style="padding:4px; font-size:12px; cursor:pointer;" onclick="window.openP(${p.id})">${p.name} - ${pr(p.price)} ت</div>`).join('') || '<div style="font-size:11px; color:var(--sub);">موردی یافت نشد</div>';
      }
      render();
    });
    window.quickSearch = q => { inp.value = q; searchQ = q; drop.classList.remove('open'); render(); };

    const tBtn = document.getElementById('themeBtn');
    function applyT(dark) {
      document.body.classList.toggle('dark-mode', dark);
      document.getElementById('themeIco').textContent = dark ? '☀️' : '🌙';
      document.getElementById('themeTxt').textContent = dark ? 'حالت روز' : 'حالت شب';
      localStorage.setItem('am_dark', dark ? '1' : '0');
    }
    tBtn.onclick = () => applyT(!document.body.classList.contains('dark-mode'));

    let sl = 0; const slides = document.querySelectorAll('.slide');
    setInterval(() => { slides[sl].classList.remove('active'); sl = (sl + 1) % slides.length; slides[sl].classList.add('active'); }, 4500);

    let s = 42, m = 18, h = 5;
    setInterval(() => {
      s--; if (s < 0) { s = 59; m--; if (m < 0) { m = 59; h--; } }
      const ss = fa(s.toString().padStart(2,'0')), mm = fa(m.toString().padStart(2,'0')), hh = fa(h.toString().padStart(2,'0'));
      document.getElementById('dSec').textContent = ss; document.getElementById('dMin').textContent = mm; document.getElementById('dHour').textContent = hh;
      document.getElementById('headerTimer').textContent = `${hh}:${mm}:${ss}`;
    }, 1000);

    document.addEventListener('DOMContentLoaded', () => {
      applyT(localStorage.getItem('am_dark') === '1');
      updateCart();
    });
  </script>
</body>
</html>
