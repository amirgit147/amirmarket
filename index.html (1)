        </a>
        <button class="loc-btn" onclick="window.openAddr()">📍 <span id="curAddr">تهران، سعادت‌آباد</span> ▼</button>
      </div>

      <div class="search-wrap">
        <span class="search-ico">🔍</span>
        <input type="text" id="searchInput" class="search-input" placeholder="جستجو بین میلیون‌ها کالا (نوتلا، بیسکویت مادر...)" autocomplete="off">
        <div class="search-drop" id="searchDrop">
